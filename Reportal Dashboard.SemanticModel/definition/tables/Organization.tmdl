table Organization
	lineageTag: be653e15-f311-42c7-a95f-ebef370dd672

	measure 'Selected Organization Scope Key' =
			VAR DivisionFiltered =
				ISFILTERED ( Organization[DivisionDisplay] )
					|| ISFILTERED ( Organization[DivisionNumber] )
			VAR DistrictFiltered =
				ISFILTERED ( Organization[DistrictDisplay] )
					|| ISFILTERED ( Organization[DistrictNumber] )
			VAR SiteFiltered =
				ISFILTERED ( Organization[SiteDisplay] )
					|| ISFILTERED ( Organization[SiteNumber] )
					|| ISFILTERED ( Organization[OrganizationSiteKey] )
			VAR AmbiguousSelection =
				( ISFILTERED ( Organization[DivisionDisplay] )
					&& COUNTROWS ( FILTERS ( Organization[DivisionDisplay] ) ) > 1 )
					|| ( ISFILTERED ( Organization[DivisionNumber] )
						&& COUNTROWS ( FILTERS ( Organization[DivisionNumber] ) ) > 1 )
					|| ( ISFILTERED ( Organization[DistrictDisplay] )
						&& COUNTROWS ( FILTERS ( Organization[DistrictDisplay] ) ) > 1 )
					|| ( ISFILTERED ( Organization[DistrictNumber] )
						&& COUNTROWS ( FILTERS ( Organization[DistrictNumber] ) ) > 1 )
					|| ( ISFILTERED ( Organization[SiteDisplay] )
						&& COUNTROWS ( FILTERS ( Organization[SiteDisplay] ) ) > 1 )
					|| ( ISFILTERED ( Organization[SiteNumber] )
						&& COUNTROWS ( FILTERS ( Organization[SiteNumber] ) ) > 1 )
					|| ( ISFILTERED ( Organization[OrganizationSiteKey] )
						&& COUNTROWS ( FILTERS ( Organization[OrganizationSiteKey] ) ) > 1 )
			VAR SelectedDivision = SELECTEDVALUE ( Organization[DivisionNumber] )
			VAR SelectedDistrict = SELECTEDVALUE ( Organization[DistrictNumber] )
			VAR SelectedSite = SELECTEDVALUE ( Organization[SiteNumber] )
			RETURN
				SWITCH (
					TRUE (),
					AmbiguousSelection || ISEMPTY ( Organization ), BLANK (),
					SiteFiltered,
						IF (
							NOT ( ISBLANK ( SelectedDivision ) )
								&& NOT ( ISBLANK ( SelectedDistrict ) )
								&& NOT ( ISBLANK ( SelectedSite ) ),
							"SITE|" & SelectedDivision & "|" & SelectedDistrict & "|" & SelectedSite,
							BLANK ()
						),
					DistrictFiltered,
						IF (
							NOT ( ISBLANK ( SelectedDivision ) )
								&& NOT ( ISBLANK ( SelectedDistrict ) ),
							"DIST|" & SelectedDivision & "|" & SelectedDistrict,
							BLANK ()
						),
					DivisionFiltered,
						IF (
							NOT ( ISBLANK ( SelectedDivision ) ),
							"DIV|" & SelectedDivision,
							BLANK ()
						),
					"ALL"
				)
		displayFolder: Organization Scope
		lineageTag: f5ec4a5b-1d0d-4c7b-8fcf-2ae3a630c1d9

