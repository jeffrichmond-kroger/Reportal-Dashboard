table 'Fiscal Period'
	lineageTag: 86f45a9b-2a20-4830-a4cb-bcfb4bb3f0b2

	measure 'Selected Fiscal Period Key' = SELECTEDVALUE ( 'Fiscal Period'[FiscalPeriodKey] )
		formatString: 0
		displayFolder: Period Context
		lineageTag: a9817601-29d7-459a-8fb5-10d104309020

	measure 'Selected Period Label' =
			IF (
				HASONEVALUE ( 'Fiscal Period'[FiscalPeriodKey] ),
				SELECTEDVALUE ( 'Fiscal Period'[PeriodLabel] )
			)
		displayFolder: Period Context
		lineageTag: a9817601-29d7-459a-8fb5-10d104309021

	measure 'Report Data As Of' =
			VAR LoadDate = [Latest YTD Source Load]
			RETURN
				"Data as of " & IF ( ISBLANK ( LoadDate ), "--", FORMAT ( LoadDate, "m/d/yyyy", "en-US" ) )
		displayFolder: Period Context
		lineageTag: a9817601-29d7-459a-8fb5-10d104309023

	measure 'Report Refresh Coverage' =
			VAR PeriodStart = SELECTEDVALUE ( 'Fiscal Period'[PeriodStartDate] )
			VAR PeriodEnd = SELECTEDVALUE ( 'Fiscal Period'[PeriodEndDate] )
			VAR CoverageText =
				IF (
					HASONEVALUE ( 'Fiscal Period'[FiscalPeriodKey] )
						&& NOT ISBLANK ( PeriodStart ) && NOT ISBLANK ( PeriodEnd ),
					" and covers " & FORMAT ( PeriodStart, "m/d/yyyy", "en-US" )
						& " to " & FORMAT ( PeriodEnd, "m/d/yyyy", "en-US" )
				)
			RETURN
				"Refreshes daily" & CoverageText
		displayFolder: Period Context
		lineageTag: a9817601-29d7-459a-8fb5-10d104309024

	measure 'Report Subtitle' = [Report Data As Of] & UNICHAR ( 10 ) & [Report Refresh Coverage]
		displayFolder: Period Context
		lineageTag: a9817601-29d7-459a-8fb5-10d104309022

