	partition 'Annual Goal' = m
		mode: import
		source =
				let
				    Source = Sql.Database("81reportal-sqlserver01-f28884e84e81bf38.database.windows.net", "reportaldb"),
				    reportal_factYTDGoals_vw = Source{[Schema="reportal",Item="factYTDGoals_vw"]}[Data],
				    #"Renamed Columns" = Table.RenameColumns(reportal_factYTDGoals_vw,{{"metric_id", "MetricKey"}, {"parent_id", "ParentMetricKey"}, {"year", "GoalYear"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"GoalYear", Int64.Type}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"goal_tx", "GoalText"}, {"end_dt", "LatestGoalDate"}, {"YER_WEK_NO", "LatestGoalWeek"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns1",{{"LatestGoalWeek", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type1", "OrganizationScopeKey", each let
				    Division = if [div_no] = null then "" else Text.Trim([div_no]),
				    District = if [zone_no] = null then "" else Text.Trim([zone_no]),
				    Site = if [loc_no] = null then "" else Text.Trim([loc_no])
				in
				    if Division = "" and District = "" and Site = "" then "ALL"
				    else if Division <> "" and District = "" and Site = "" then "DIV|" & Division
				    else if Division <> "" and District <> "" and Site = "" then "DIST|" & Division & "|" & District
				    else if Division <> "" and District <> "" and Site <> "" then "SITE|" & Division & "|" & District & "|" & Site
				    else null)
				in
				    #"Added Custom"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

