table 'Annual Goal'
	lineageTag: 148885d9-1602-4e93-92e9-194dbb35df8c

	measure 'Current Goal Raw Text' =
			
			VAR TargetYear = SELECTEDVALUE ( 'Fiscal Period'[FiscalYear] )
			VAR ScopeKey = [Selected Organization Scope Key]
			VAR GoalRows =
			    CALCULATETABLE (
			        'Annual Goal',
			        TREATAS ( { TargetYear }, 'Annual Goal'[GoalYear] ),
			        TREATAS ( { ScopeKey }, 'Annual Goal'[OrganizationScopeKey] )
			    )
			RETURN
			    IF (
			        NOT ( ISBLANK ( TargetYear ) )
			            && NOT ( ISBLANK ( ScopeKey ) )
			            && HASONEVALUE ( Metric[MetricKey] )
			            && COUNTROWS ( GoalRows ) = 1,
			        MAXX ( GoalRows, 'Annual Goal'[GoalText] )
			    )
		lineageTag: 8a7ed0fa-65b1-4471-92a6-836fa71827ea

	measure 'Current Goal Display Text' =
			
			VAR RawText = [Current Goal Raw Text]
			VAR CleanText = TRIM ( RawText )
			VAR HasPercentSuffix = RIGHT ( CleanText, 1 ) = "%"
			VAR NumericText =
			    IF (
			        HasPercentSuffix,
			        LEFT ( CleanText, LEN ( CleanText ) - 1 ),
			        CleanText
			    )
			VAR NumericGoal = IFERROR ( VALUE ( NumericText ), BLANK () )
			VAR SourceMask = SELECTEDVALUE ( Metric[SummaryFormatMask] )
			VAR NumberPattern = [Metric Numeric Format]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( RawText ) || CleanText = "", BLANK (),
			        ISBLANK ( NumericGoal ), RawText,
			        SourceMask = "%" || HasPercentSuffix,
			            FORMAT ( NumericGoal, NumberPattern, "en-US" ) & "%",
			        SELECTEDVALUE ( Metric[MetricKey] ) = 12
			            && ABS ( NumericGoal ) >= 1000000,
			            FORMAT ( DIVIDE ( NumericGoal, 1000000 ), "0.00", "en-US" ) & "M",
			        FORMAT ( NumericGoal, NumberPattern, "en-US" )
			    )
		lineageTag: d989c2fc-7fae-4452-996f-93781111442f

