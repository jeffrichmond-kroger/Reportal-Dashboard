model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["Fiscal Period","Fiscal Week","Metric","Organization","Weekly Score","YTD Score"]

ref table 'Fiscal Period'
ref table 'Fiscal Week'
ref table Metric
ref table Organization
ref table 'Weekly Score'
ref table 'YTD Score'

ref cultureInfo en-US

