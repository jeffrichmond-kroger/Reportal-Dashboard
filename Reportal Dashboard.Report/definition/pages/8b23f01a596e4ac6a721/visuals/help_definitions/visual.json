            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read this",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "20pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Reportal Dashboard",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#616161"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Organization scope",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Division All represents the ALL result, regardless of District or Site selections. A selected Division with District All represents DIV; a selected District with Site All represents DIST. All three explicitly selected represent SITE. Invalid or ambiguous active selections have no result.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Weekly and YTD results",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Weekly results belong to the selected fiscal week. YTD uses the latest loaded week within the selected period and organization scope, with one common endpoint across metrics. No earlier period or older metric-specific result is substituted. Scores are supplied results, not averages or recalculated rollups.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Current annual goals",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Goals use the current source row for the selected year, organization scope, and metric, including when an earlier period is selected. Goal dates and weeks are audit metadata, not as-of filters. Goals change with source refresh; another year, scope, or snapshot is never used as a fallback.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#242424"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Values and status",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16pt",
                      "fontWeight": "bold",
                      "color": "#111111"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Blank is not zero. Missing, duplicate, or invalid result contexts remain blank. Source percentage values retain their original scale; Rx Sold values of at least one million display in millions. Status colors and trend arrows come from the source; blank or hide status has no visible color. Arrow direction alone does not establish favorable performance.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#242424"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
