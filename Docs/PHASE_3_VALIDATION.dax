EVALUATE
SELECTCOLUMNS (
    FILTER (
        ALL ( 'YTD Score' ),
        'YTD Score'[OrganizationScopeKey] = "ALL"
            && 'YTD Score'[FiscalPeriodKey] = 202610
            && 'YTD Score'[MetricKey] IN { 17, 3, 2, 4, 87, 90, 12 }
    ),
    "FiscalPeriodKey", 'YTD Score'[FiscalPeriodKey],
    "FiscalWeekKey", 'YTD Score'[FiscalWeekKey],
    "SnapshotDate", 'YTD Score'[SnapshotDate],
    "MetricKey", 'YTD Score'[MetricKey],
    "MetricName", RELATED ( Metric[MetricName] ),
    "ScoreValue", 'YTD Score'[ScoreValue],
    "DisplayValue", 'YTD Score'[DisplayValue],
    "UnderlyingValue", 'YTD Score'[UnderlyingValue],
    "GoalValue", 'YTD Score'[GoalValue],
    "ColorCode", 'YTD Score'[ColorCode],
    "CalculationText", 'YTD Score'[CalculationText],
    "LoadDateTime", 'YTD Score'[LoadDateTime]
)
ORDER BY [FiscalWeekKey], [MetricKey], [LoadDateTime]

EVALUATE
SELECTCOLUMNS (
    FILTER (
        ALL ( 'Weekly Score' ),
        'Weekly Score'[OrganizationScopeKey] = "ALL"
            && 'Weekly Score'[FiscalPeriodKey] = 202610
            && 'Weekly Score'[MetricKey] IN { 17, 3, 2, 4, 87, 90, 12 }
    ),
    "FiscalPeriodKey", 'Weekly Score'[FiscalPeriodKey],
    "FiscalWeekKey", 'Weekly Score'[FiscalWeekKey],
    "WeekStartDate", 'Weekly Score'[WeekStartDate],
    "WeekEndDate", 'Weekly Score'[WeekEndDate],
    "MetricKey", 'Weekly Score'[MetricKey],
    "MetricName", RELATED ( Metric[MetricName] ),
    "ScoreValue", 'Weekly Score'[ScoreValue],
    "DisplayValue", 'Weekly Score'[DisplayValue],
    "UnderlyingValue", 'Weekly Score'[UnderlyingValue],
    "GoalText", 'Weekly Score'[GoalText],
    "ColorCode", 'Weekly Score'[ColorCode],
    "ArrowCode", 'Weekly Score'[ArrowCode],
    "CalculationText", 'Weekly Score'[CalculationText]
)
ORDER BY [FiscalWeekKey], [MetricKey]

EVALUATE
SELECTCOLUMNS (
    FILTER ( ALL ( Metric ), Metric[DashboardVisibleFlag] && NOT ( Metric[HiddenFlag] ) ),
    "MetricKey", Metric[MetricKey],
    "MetricName", Metric[MetricName],
    "SortNumber", Metric[SortNumber],
    "SummaryFormatMask", Metric[SummaryFormatMask],
    "SummaryRoundingNumber", Metric[SummaryRoundingNumber],
    "DetailFormatMask", Metric[DetailFormatMask],
    "DetailRoundingNumber", Metric[DetailRoundingNumber],
    "LowThresholdText", Metric[LowThresholdText],
    "HighThresholdText", Metric[HighThresholdText],
    "MetricDescription", Metric[MetricDescription]
)
ORDER BY [SortNumber], [MetricKey]

EVALUATE
VAR WeeklyRows =
    FILTER (
        ALL ( 'Weekly Score' ),
        'Weekly Score'[OrganizationScopeKey] = "ALL"
            && 'Weekly Score'[FiscalPeriodKey] = 202610
    )
VAR WeeklyGrains =
    GROUPBY (
        WeeklyRows,
        'Weekly Score'[OrganizationScopeKey],
        'Weekly Score'[FiscalWeekKey],
        'Weekly Score'[MetricKey],
        "RowsAtGrain", COUNTX ( CURRENTGROUP (), 1 )
    )
VAR YtdRows =
    FILTER (
        ALL ( 'YTD Score' ),
        'YTD Score'[OrganizationScopeKey] = "ALL"
            && 'YTD Score'[FiscalPeriodKey] = 202610
    )
VAR YtdGrains =
    GROUPBY (
        YtdRows,
        'YTD Score'[OrganizationScopeKey],
        'YTD Score'[FiscalWeekKey],
        'YTD Score'[MetricKey],
        "RowsAtGrain", COUNTX ( CURRENTGROUP (), 1 )
    )
RETURN
    UNION (
        ROW (
            "Fact", "Weekly Score",
            "Scope", "ALL",
            "FiscalPeriodKey", 202610,
            "Source rows", COUNTROWS ( WeeklyRows ) + 0,
            "Distinct grains", COUNTROWS ( WeeklyGrains ) + 0,
            "Duplicate grains", COUNTROWS ( FILTER ( WeeklyGrains, [RowsAtGrain] > 1 ) ) + 0,
            "Endpoint weeks", COUNTROWS ( SUMMARIZE ( WeeklyRows, 'Weekly Score'[FiscalWeekKey] ) ) + 0
        ),
        ROW (
            "Fact", "YTD Score",
            "Scope", "ALL",
            "FiscalPeriodKey", 202610,
            "Source rows", COUNTROWS ( YtdRows ) + 0,
            "Distinct grains", COUNTROWS ( YtdGrains ) + 0,
            "Duplicate grains", COUNTROWS ( FILTER ( YtdGrains, [RowsAtGrain] > 1 ) ) + 0,
            "Endpoint weeks", COUNTROWS ( SUMMARIZE ( YtdRows, 'YTD Score'[FiscalWeekKey] ) ) + 0
        )
    )
ORDER BY [Fact]

EVALUATE
CALCULATETABLE (
    SUMMARIZECOLUMNS (
        Metric[MetricKey],
        Metric[MetricName],
        'Fiscal Week'[FiscalWeekKey],
        'Fiscal Week'[WeekColumnLabel],
        TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
        TREATAS ( { 202610 }, 'Fiscal Week'[FiscalPeriodKey] ),
        TREATAS ( { 17, 3, 2, 4, 87, 90, 12 }, Metric[MetricKey] ),
        "Scope", [Selected Organization Scope Key],
        "Week label", [Selected Week Label],
        "Week date label", [Selected Week Date Label],
        "Weekly rows", [Weekly Result Row Count],
        "Weekly score", [Weekly Score Value],
        "Weekly display value", [Weekly Display Value],
        "Weekly display text", [Weekly Display Text],
        "Weekly underlying value", [Weekly Underlying Value],
        "Weekly goal text", [Weekly Goal Text],
        "Weekly color", [Weekly Color],
        "Weekly arrow", [Weekly Arrow],
        "YTD endpoint", [Selected YTD Endpoint Week Key],
        "YTD score under week filter", [YTD Score Value]
    ),
    REMOVEFILTERS ( Organization )
)
ORDER BY 'Fiscal Week'[FiscalWeekKey], Metric[MetricKey]

EVALUATE
CALCULATETABLE (
    SUMMARIZECOLUMNS (
        Metric[MetricKey],
        Metric[MetricName],
        TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
        TREATAS ( { 17, 3, 2, 4, 87, 90, 12 }, Metric[MetricKey] ),
        "Scope", [Selected Organization Scope Key],
        "Period label", [Selected Period Label],
        "YTD endpoint", [Selected YTD Endpoint Week Key],
        "YTD rows", [YTD Result Row Count],
        "YTD score", [YTD Score Value],
        "YTD display value", [YTD Display Value],
        "YTD display text", [YTD Display Text],
        "YTD underlying value", [YTD Underlying Value],
        "YTD goal value", [YTD Goal Value],
        "YTD goal text", [YTD Goal Text],
        "YTD color", [YTD Color]
    ),
    REMOVEFILTERS ( Organization )
)
ORDER BY Metric[MetricKey]

EVALUATE
VAR GuardResults =
    UNION (
        ROW (
            "Test", "YTD without a selected period returns blank",
            "Actual",
                CALCULATE (
                    [YTD Score Value],
                    REMOVEFILTERS ( Organization ),
                    REMOVEFILTERS ( 'Fiscal Period' ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 17 }, Metric[MetricKey] )
                )
        ),
        ROW (
            "Test", "YTD across two metrics returns blank",
            "Actual",
                CALCULATE (
                    [YTD Score Value],
                    REMOVEFILTERS ( Organization ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
                    TREATAS ( { 17, 3 }, Metric[MetricKey] )
                )
        ),
        ROW (
            "Test", "Weekly without a single week returns blank",
            "Actual",
                CALCULATE (
                    [Weekly Score Value],
                    REMOVEFILTERS ( Organization ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
                    TREATAS ( { 17 }, Metric[MetricKey] )
                )
        ),
        ROW (
            "Test", "Weekly across two metrics returns blank",
            "Actual",
                CALCULATE (
                    [Weekly Score Value],
                    REMOVEFILTERS ( Organization ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
                    TREATAS ( { 202637 }, 'Fiscal Week'[FiscalWeekKey] ),
                    TREATAS ( { 17, 3 }, Metric[MetricKey] )
                )
        ),
        ROW (
            "Test", "Weekly with an invalid organization returns blank",
            "Actual",
                CALCULATE (
                    [Weekly Score Value],
                    FILTER ( ALL ( Organization ), FALSE () ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
                    TREATAS ( { 202637 }, 'Fiscal Week'[FiscalWeekKey] ),
                    TREATAS ( { 17 }, Metric[MetricKey] )
                )
        ),
        ROW (
            "Test", "YTD with an invalid organization returns blank",
            "Actual",
                CALCULATE (
                    [YTD Score Value],
                    FILTER ( ALL ( Organization ), FALSE () ),
                    REMOVEFILTERS ( 'Fiscal Week' ),
                    REMOVEFILTERS ( Metric ),
                    TREATAS ( { 202610 }, 'Fiscal Period'[FiscalPeriodKey] ),
                    TREATAS ( { 17 }, Metric[MetricKey] )
                )
        )
    )
RETURN
    ADDCOLUMNS ( GuardResults, "Expected", "BLANK", "Pass/Fail", IF ( ISBLANK ( [Actual] ), "PASS", "FAIL" ) )
ORDER BY [Test]